generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

model User {
  id            String     @id @default(cuid())
  privyDid      String?    @unique
  walletAddress String?    @unique
  email         String?
  userHash      String?    @unique
  name          String
  cpf           String?
  isProducer    Boolean    @default(false)
  isAdmin       Boolean    @default(false)
  syncStatus    SyncStatus @default(PENDING)
  onChainAt     DateTime?
  syncedAt      DateTime   @default(now()) @updatedAt

  // Contato
  phone         String?
  phone2        String?

  // Endereço (local de produção)
  street        String?
  addressNumber String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  zipCode       String?

  // Associação / Cooperativa
  assocName     String?
  assocCnpj     String?
  assocRole     String?

  // Terreno
  landSizeHa    Float?
  landType      String?

  // Sobre
  bio           String?

  @@index([walletAddress])
  @@index([privyDid])
  @@index([syncStatus])
}

model Product {
  id                  String     @id @default(cuid())
  lotId               String     @unique
  productName         String     @default("")
  volume              Int
  unit                String     @default("KG")
  pricePerUnit        Float?
  origin              String
  originType          String     @default("PESSOA")
  producerAddress     String
  producerName        String     @default("")
  currentOwnerAddress String
  currentOwnerName    String     @default("")
  documentHash        String
  active              Boolean    @default(true)
  syncStatus          SyncStatus @default(SYNCED)
  onChainAt           DateTime?
  syncedAt            DateTime   @default(now()) @updatedAt
  traces              Trace[]

  @@index([producerAddress])
  @@index([currentOwnerAddress])
  @@index([active])
  @@index([syncStatus])
}

model Trace {
  id             String   @id
  product        Product  @relation(fields: [productId], references: [id])
  productId      String
  actor          String
  action         String
  docHash        String
  fromAddress    String
  toAddress      String
  fromName       String   @default("")
  toName         String   @default("")
  blockTimestamp DateTime
  txHash         String?
  blockNumber    BigInt?
  createdAt      DateTime @default(now())

  @@index([productId])
}

model SyncState {
  id        Int    @id @default(1)
  lastBlock BigInt @default(0)
}

model PendingOperation {
  id          String     @id @default(cuid())
  type        String     // REGISTER_USER | ADD_PRODUCT | TRANSFER_PRODUCT | MAKE_PRODUCER | DEACTIVATE_PRODUCT
  params      Json
  userAddress String
  status      SyncStatus @default(PENDING)
  txHash      String?
  errorMsg    String?
  refId       String?    // lotId or walletAddress
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userAddress, status])
  @@index([status])
}
